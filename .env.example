# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/balance_vault?schema=public"

# Application Security Secrets
JWT_SECRET="replace-with-a-secure-random-secret-for-jwt-signing"
LEDGER_HMAC_SECRET="replace-with-a-secure-random-secret-for-ledger-hmac"

# Initial Admin Bootstrap Credentials
INITIAL_ADMIN_EMAIL="admin@balancevault.local"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-admin-password"
INITIAL_ADMIN_NAME="System Administrator"

# System Treasury & Capital Reserve Accounts
SYSTEM_EQUITY_ACCOUNT_NUMBER="VAULT-EQUITY-0000"
SYSTEM_TREASURY_ACCOUNT_NUMBER="VAULT-SYSTEM-0001"

